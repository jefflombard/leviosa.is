---
// Assets
import { Image } from "astro:assets";
import clinic from "@/images/landing/hero.jpg";
import comfort from "@/images/blog/comfort.jpg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div data-hero class="flex flex-col items-start gap-6">
      <Text tag="h1" variant="display2XL" class="max-w-4xl font-display tracking-tight text-balance">
        A neighbourhood clinic that never rushes a smile.
      </Text>
      <Text tag="p" variant="textLG" class="max-w-xl text-pretty text-muted-foreground lg:text-balance">
        Scarlet opened in 2014 with two chairs and one promise: take the time to explain.
      </Text>
    </div>
    <div class="mt-12 grid gap-2 lg:grid-cols-3">
      <div class="overflow-hidden rounded-3xl bg-primary lg:col-span-2 lg:rounded-4xl">
        <Image
          src={clinic}
          alt="The Scarlet treatment room with a dental chair by the window"
          width={1400}
          loading="eager"
          class="aspect-4/3 size-full object-cover grayscale mix-blend-screen"
        />
      </div>
      <div class="overflow-hidden rounded-3xl bg-primary lg:rounded-4xl">
        <Image
          src={comfort}
          alt="A patient relaxing in the chair before a check-up"
          width={800}
          loading="eager"
          class="aspect-4/3 size-full object-cover grayscale mix-blend-screen"
        />
      </div>
    </div>
  </Wrapper>
</section>
