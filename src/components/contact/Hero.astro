---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="pt-24 pb-16 lg:pt-40 lg:pb-24">
    <div data-hero class="flex flex-col items-start gap-6">
      <Text tag="h1" variant="display2XL" class="max-w-4xl font-display tracking-tight text-balance">
        Talk to a real person, not a booking bot.
      </Text>
      <div class="flex flex-col items-start">
        <Text tag="p" variant="textLG" class="max-w-xl text-pretty text-muted-foreground lg:text-balance">
          Call, write or send a request below. The front desk answers every message within a working day.
        </Text>
        <div class="mt-8 flex flex-wrap gap-2">
          <Button isLink href="#contact" variant="primary" size="base">
            Request a visit
          </Button>
          <Button isLink href="tel:+15550102030" variant="muted" size="base">
            Call the clinic
          </Button>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
