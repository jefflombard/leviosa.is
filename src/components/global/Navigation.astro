---
// Assets
import { Image } from "astro:assets";
import featuredImage from "@/images/landing/contact.jpg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import Logo from "@/components/assets/Logo.astro";
// Icons
import ChevronDown from "@/icons/chevron-down.svg";
import ArrowRight from "@/icons/arrow-right.svg";
import Menu from "@/icons/menu.svg";
import Close from "@/icons/close.svg";
// Content
import { getCollection } from "astro:content";
import { closing, ongoingCare, overview, stages } from "@/components/platform/journey";
// Props
const { overlay = false } = Astro.props;
const treatments = (await getCollection("treatments"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((treatment) => ({
    title: treatment.data.title,
    price: treatment.data.price,
    href: `/treatments/${treatment.id}`,
  }));
const patients = [
  { label: "New patients", description: "What to bring and what to expect", href: "/new-patients" },
  { label: "Emergency", description: "Same-day care, six days a week", href: "/emergency" },
  { label: "Children", description: "Gentle visits from the first tooth", href: "/children" },
  { label: "Pricing", description: "Every price, in writing", href: "/pricing" },
  { label: "Smile stories", description: "Real patients, real results", href: "/stories" },
  { label: "Reviews", description: "In our patients' own words", href: "/reviews" },
  { label: "FAQ", description: "Answers before you ask", href: "/faq" },
];
const clinicLinks = [
  { label: "About", description: "Twelve years on one street", href: "/about" },
  { label: "Our clinic", description: "Rooms, equipment and access", href: "/clinic" },
  { label: "Team", description: "The faces you will see", href: "/team" },
  { label: "Careers", description: "Join a kinder practice", href: "/careers" },
];
const groups = [
  { label: "Patients", links: patients },
  { label: "Clinic", links: clinicLinks },
];
const platform = {
  intro: [overview, ongoingCare].map((item) => ({ label: item.title, description: item.description, href: "/book-demo" })),
  groups: stages.map((stage) => ({
    label: stage.label,
    icon: stage.icon,
    links: stage.items.map((item) => ({ label: item.title, href: "/book-demo" })),
  })),
  footer: { label: closing, href: "/book-demo" },
};
const audiences = {
  business: [
    { label: "Private Practice", description: "Letting you focus on delivering quality care." },
    { label: "Group Practice", description: "For group practices and clinics." },
    { label: "Public Health", description: "For public clinics and health services caring for whole communities." },
  ].map((item) => ({ ...item, href: "/book-demo" })),
  focus: ["Behavioral Health", "Family Care", "Women's Health", "Nutrition", "Health Coaching", "Chronic Care & MSK", "Psychology", "Dentistry"].map(
    (label) => ({ label, href: "/book-demo", badge: label === "Dentistry" ? "Coming soon" : undefined }),
  ),
  featured: {
    label: "Success Stories",
    description: "Meet the clinics that use Leviosa to scale their impact.",
    href: "/book-demo",
    image: featuredImage,
    alt: "A clinician smiling behind a reception desk",
  },
};
const links = [
  { label: "Platform", href: "/platform", menu: "platform" },
  { label: "Who We Serve", href: "/who-we-serve", menu: "who-we-serve" },
  { label: "Pricing", href: "/pricing" },
  { label: "Resources", href: "/blog" },
];
const mobileGroups = [
  {
    label: "Treatments",
    links: [
      ...treatments.map((treatment) => ({ label: treatment.title, href: treatment.href })),
      { label: "All treatments", href: "/treatments" },
    ],
  },
  ...groups,
];
const path = Astro.url.pathname.replace(/^\/is(?=\/|$)/, "") || "/";
const currentLanguage = Astro.url.pathname.match(/^\/is(\/|$)/) ? "is" : "en";
const languages = [
  { code: "is", label: "IS", name: "Íslenska", href: `/is${path === "/" ? "" : path}` },
  { code: "en", label: "EN", name: "English", href: path },
];
---

<header
  data-headroom
  data-nav
  class:list={[
    "top-0 z-20 transition-colors duration-300 data-scrolled:bg-background/90 data-scrolled:text-foreground data-scrolled:backdrop-blur data-open:bg-background data-open:text-foreground",
    overlay ? "fixed inset-x-0 text-primary-foreground" : "sticky",
  ]}
>
  <Wrapper variant="standard">
    <nav aria-label="Main" class="flex items-center justify-between gap-8 py-4">
      <div class="flex items-center gap-12">
        <a href="/" aria-label="Leviosa home" class="flex outline-none">
          <Logo />
        </a>
        <ul class="hidden items-baseline gap-8 lg:flex">
          {
            links.map((link) => (
              <li class="flex">
                {link.menu ? (
                  <Button outline={false}
                    variant="none"
                    gap="xs"
                    type="button"
                    class="group text-sm transition-opacity hover:opacity-70"
                    aria-expanded="false"
                    aria-controls={`menu-${link.menu}`}
                    data-menu-trigger={link.menu}
                  >
                    {link.label}
                    <ChevronDown
                      slot="right-icon"
                      class="size-3.5 transition-transform duration-300 group-aria-expanded:rotate-180"
                      aria-hidden="true"
                    />
                  </Button>
                ) : (
                <Text tag="a" href={link.href} variant="textSM" class="outline-none font-medium transition-opacity hover:opacity-70">
                  {link.label}
                </Text>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex items-center gap-2">
        <ul aria-label="Language" class="flex h-9 items-center rounded-full bg-muted p-1 text-sm font-medium">
          {
            languages.map((language) => (
              <li class="flex h-full">
                <a
                  href={language.href}
                  hreflang={language.code}
                  lang={language.code}
                  aria-label={language.name}
                  aria-current={language.code === currentLanguage ? "true" : undefined}
                  class:list={[
                    "flex items-center rounded-full px-3 outline-none transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-ring",
                    language.code === currentLanguage ? "bg-background text-foreground" : "text-muted-foreground hover:text-foreground",
                  ]}
                >
                  {language.label}
                </a>
              </li>
            ))
          }
        </ul>
        <Button outline={false} isLink href="https://buy.polar.sh/polar_cl_WeEs4fKPvE0MaL5XFBJNvwrvocCKGewiNmKu30UFQct" variant="accent" size="sm" class="hidden sm:flex">
          Talk to a Human
        </Button>
        <Button outline={false}
          variant="muted"
          size="sm"
          iconOnly
          type="button"
          class="lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-mobile-open
        >
          <Menu slot="icon" class="size-5" aria-hidden="true" />
        </Button>
      </div>
    </nav>
  </Wrapper>
  <div class="absolute inset-x-0 top-full hidden lg:block">
    <Wrapper variant="standard">
      <div
        id="menu-platform"
        data-menu-panel="platform"
        hidden
        class="rounded-4xl bg-primary p-10 text-primary-foreground shadow-2xl shadow-foreground/10"
      >
        <div class="grid grid-cols-[1.4fr_repeat(5,1fr)] gap-8">
          <ul class="grid content-start gap-8">
            {
              platform.intro.map((link) => (
                <li>
                  <a href={link.href} class="group block outline-none">
                    <Text tag="span" variant="textLG" class="block font-display font-medium tracking-tight transition-colors group-hover:text-accent">
                      {link.label}
                    </Text>
                    <Text tag="span" variant="textSM" class="mt-2 block text-primary-foreground/70 text-pretty">
                      {link.description}
                    </Text>
                  </a>
                </li>
              ))
            }
          </ul>
          {
            platform.groups.map((group) => (
              <div>
                <Text tag="p" variant="textSM" class="flex items-center gap-2 text-primary-foreground/70">
                  <group.icon class="size-4 shrink-0" aria-hidden="true" />
                  {group.label}
                </Text>
                <ul class="mt-4 grid gap-4 border-t border-primary-foreground/15 pt-5">
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href} class="group block outline-none">
                        <Text tag="span" variant="textBase" class="block font-display font-medium tracking-tight transition-colors group-hover:text-accent">
                          {link.label}
                        </Text>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="mt-10 border-t border-primary-foreground/15 pt-6">
          <a href={platform.footer.href} class="group inline-flex items-center gap-2 outline-none">
            <Text tag="span" variant="textSM" class="font-medium transition-colors group-hover:text-accent">
              {platform.footer.label}
            </Text>
            <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
          </a>
        </div>
      </div>
      <div
        id="menu-who-we-serve"
        data-menu-panel="who-we-serve"
        hidden
        class="rounded-4xl bg-primary p-10 text-primary-foreground shadow-2xl shadow-foreground/10"
      >
        <div class="grid grid-cols-4 gap-12">
          <div>
            <Text tag="p" variant="textSM" class="text-primary-foreground/70">
              Business type
            </Text>
            <ul class="mt-4 grid gap-8 border-t border-primary-foreground/15 pt-5">
              {
                audiences.business.map((link) => (
                  <li>
                    <a href={link.href} class="group block outline-none">
                      <Text tag="span" variant="textLG" class="block font-display font-medium tracking-tight transition-colors group-hover:text-accent">
                        {link.label}
                      </Text>
                      <Text tag="span" variant="textSM" class="mt-2 block text-primary-foreground/70 text-pretty">
                        {link.description}
                      </Text>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="col-span-2">
            <Text tag="p" variant="textSM" class="text-primary-foreground/70">
              Clinical focus
            </Text>
            <ul class="mt-4 grid grid-cols-2 gap-x-8 gap-y-4 border-t border-primary-foreground/15 pt-5">
              {
                audiences.focus.map((link) => (
                  <li>
                    <a href={link.href} class="group flex items-center gap-2 outline-none">
                      <Text tag="span" variant="textBase" class="block font-display font-medium tracking-tight transition-colors group-hover:text-accent">
                        {link.label}
                      </Text>
                      {link.badge && (
                        <Text tag="span" variant="textXS" class="rounded-full bg-primary-foreground/15 px-2 py-0.5 font-medium text-primary-foreground/70">
                          {link.badge}
                        </Text>
                      )}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <a href={audiences.featured.href} class="group flex flex-col outline-none">
            <span class="block overflow-hidden rounded-3xl bg-primary">
              <Image
                src={audiences.featured.image}
                alt={audiences.featured.alt}
                width={480}
                class="aspect-4/3 w-full object-cover grayscale mix-blend-screen transition-transform duration-700 group-hover:scale-105"
              />
            </span>
            <Text tag="span" variant="textLG" class="mt-4 block font-display font-medium tracking-tight transition-colors group-hover:text-accent">
              {audiences.featured.label}
            </Text>
            <Text tag="span" variant="textSM" class="mt-1 block text-primary-foreground/70 text-pretty">
              {audiences.featured.description}
            </Text>
          </a>
        </div>
      </div>
    </Wrapper>
  </div>
</header>
<div
  id="mobile-menu"
  data-mobile-menu
  data-lenis-prevent
  hidden
  class="fixed inset-0 z-30 overflow-y-auto overscroll-contain bg-background text-foreground lg:hidden"
>
  <Wrapper variant="standard" class="flex min-h-full flex-col pb-8">
    <div class="flex items-center justify-between gap-8 py-4">
      <a href="/" aria-label="Leviosa home" class="flex outline-none">
        <Logo />
      </a>
      <Button outline={false} variant="muted" size="sm" iconOnly type="button" aria-label="Close menu" data-mobile-close>
        <Close slot="icon" class="size-5" aria-hidden="true" />
      </Button>
    </div>
    <ul class="mt-8 grid gap-4">
      {
        links.map((link) => (
          <li data-mobile-item>
            <Text tag="a" href={link.href} variant="displayXS" class="outline-none font-display font-medium tracking-tight">
              {link.label}
            </Text>
          </li>
        ))
      }
    </ul>
    <div class="mt-12 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3">
      {
        mobileGroups.map((group) => (
          <div data-mobile-item>
            <Text tag="p" variant="textSM" class="text-muted-foreground">
              {group.label}
            </Text>
            <ul class="mt-4 grid gap-3 border-t border-border pt-4">
              {group.links.map((link) => (
                <li>
                  <Text tag="a" href={link.href} variant="textLG" class="outline-none font-display font-medium tracking-tight">
                    {link.label}
                  </Text>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div data-mobile-item class="mt-auto flex flex-wrap gap-2 pt-12">
      <Button outline={false} isLink href="/book" variant="primary" size="base">
        Book a visit
      </Button>
      <Button outline={false} isLink href="https://buy.polar.sh/polar_cl_WeEs4fKPvE0MaL5XFBJNvwrvocCKGewiNmKu30UFQct" variant="accent" size="base">
        Buy Scarlet
      </Button>
    </div>
  </Wrapper>
</div>

<script>
  import { gsap } from "gsap";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const header = document.querySelector<HTMLElement>("[data-nav]");
  const triggers = [...document.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-menu-panel]")];

  const showPanel = (panel: HTMLElement) => {
    if (!panel.hidden && !gsap.isTweening(panel)) return;
    gsap.killTweensOf(panel);
    panel.hidden = false;
    if (reduceMotion) return;
    gsap.fromTo(panel, { autoAlpha: 0, y: -4 }, { autoAlpha: 1, y: 0, duration: 0.3, ease: "power2.out" });
  };
  const hidePanel = (panel: HTMLElement) => {
    if (panel.hidden) return;
    gsap.killTweensOf(panel);
    if (reduceMotion) {
      panel.hidden = true;
      return;
    }
    gsap.to(panel, {
      autoAlpha: 0,
      duration: 0.15,
      ease: "power2.in",
      onComplete: () => {
        panel.hidden = true;
      },
    });
  };

  const open = (id: string | null) => {
    triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", String(trigger.dataset.menuTrigger === id)));
    panels.forEach((panel) => (panel.dataset.menuPanel === id ? showPanel(panel) : hidePanel(panel)));
    header?.toggleAttribute("data-open", id !== null);
  };
  triggers.forEach((trigger) => {
    const id = trigger.dataset.menuTrigger ?? null;
    trigger.addEventListener("click", () => open(trigger.getAttribute("aria-expanded") === "true" ? null : id));
  });
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (!target.closest("[data-menu-panel], [data-menu-trigger]")) open(null);
  });
  window.addEventListener("scroll", () => open(null), { passive: true });

  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const mobileOpen = document.querySelector<HTMLButtonElement>("[data-mobile-open]");
  const mobileClose = document.querySelector<HTMLButtonElement>("[data-mobile-close]");
  const mobileItems = mobileMenu?.querySelectorAll("[data-mobile-item]") ?? [];
  const setMobile = (isOpen: boolean) => {
    if (!mobileMenu || mobileOpen?.getAttribute("aria-expanded") === String(isOpen)) return;
    mobileOpen?.setAttribute("aria-expanded", String(isOpen));
    gsap.killTweensOf([mobileMenu, ...mobileItems]);
    const finish = () => {
      mobileMenu.hidden = !isOpen;
    };
    if (isOpen) {
      finish();
      if (reduceMotion) return;
      gsap.fromTo(mobileMenu, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.3, ease: "power2.out" });
      gsap.fromTo(
        mobileItems,
        { autoAlpha: 0, y: 24 },
        { autoAlpha: 1, y: 0, duration: 0.6, ease: "power3.out", stagger: 0.06, delay: 0.1 },
      );
      return;
    }
    if (reduceMotion) return finish();
    gsap.to(mobileMenu, { autoAlpha: 0, duration: 0.25, ease: "power2.in", onComplete: finish });
  };
  mobileOpen?.addEventListener("click", () => setMobile(true));
  mobileClose?.addEventListener("click", () => setMobile(false));
  window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
    if (event.matches) setMobile(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const active = triggers.find((trigger) => trigger.getAttribute("aria-expanded") === "true");
    open(null);
    active?.focus();
    if (mobileMenu && !mobileMenu.hidden) setMobile(false);
  });
</script>
