---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/icons/plus.svg";
// Content
const faqs = [
  {
    question: "Do you take new patients?",
    answer: "Yes. Book online or send the form below and we'll call you back within a working day.",
  },
  {
    question: "What if I'm nervous about the dentist?",
    answer:
      "Tell us when you book. We'll give you a longer first appointment, explain every step and stop whenever you need.",
  },
  {
    question: "Do you see children?",
    answer: "We see patients of every age, from a child's first check-up onwards.",
  },
  {
    question: "What counts as an emergency?",
    answer:
      "Severe pain, swelling, a broken or knocked-out tooth, or bleeding that won't stop. Call us and we'll see you the same day.",
  },
  {
    question: "Can I spread the cost of treatment?",
    answer:
      "Yes. Any treatment over €500 can be paid monthly, and the care plan covers your routine visits for €19 a month.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-24 ">
    <div class="grid gap-12 rounded-3xl bg-muted p-6 sm:p-8 lg:grid-cols-5 lg:gap-16 lg:rounded-4xl lg:p-16">
      <div class="flex flex-col items-start justify-between gap-12 lg:col-span-2">
        <div>
          <Text tag="h2" variant="displayXL" class="font-display tracking-tight text-balance">
            Questions, answered.
          </Text>
          <Text tag="p" variant="textLG" class="mt-4 max-w-sm text-muted-foreground">
            Anything else? Our front desk answers the phone six days a week.
          </Text>
        </div>
        <Button isLink href="tel:+15550102030" variant="primary" size="base">
          Call (555) 010-2030
        </Button>
      </div>
      <div data-animate="fade-up" data-stagger="0.06" class="grid content-start gap-2 lg:col-span-3">
        {
          faqs.map((faq) => (
            <details data-accordion class="group rounded-2xl bg-background lg:rounded-3xl">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-6">
                <Text tag="span" variant="textLG" class="font-display">
                  {faq.question}
                </Text>
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted transition-colors duration-300 group-data-expanded:bg-primary group-data-expanded:text-primary-foreground">
                  <Plus class="size-4 transition-transform duration-300 group-data-expanded:rotate-45" />
                </span>
              </summary>
              <div data-accordion-content class="overflow-hidden">
                <Text tag="p" variant="textBase" class="max-w-xl px-6 pb-6 text-muted-foreground">
                  {faq.answer}
                </Text>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
