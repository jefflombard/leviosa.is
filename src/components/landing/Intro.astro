---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Arch from "@/icons/arch.svg";
// Content
const stats = [
  { value: "4.9", label: "Average rating from 600+ patient reviews" },
  { value: "12 years", label: "Caring for families in the neighbourhood" },
  { value: "Same day", label: "Emergency appointments, six days a week" },
];
---

<section>
  <Wrapper variant="standard" class="py-24 ">
    <div class="relative overflow-hidden rounded-3xl bg-muted px-6 py-24 sm:px-10 lg:rounded-4xl lg:px-16 ">
      <Arch
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-24 -right-24 w-2/3 text-secondary lg:w-1/3"
      />
      <div class="relative">
        <Text
          tag="h2"
          variant="display2XL"
          data-animate="fade-up"
          class="max-w-5xl font-display tracking-tight text-balance"
        >
          One calm clinic for check-ups, hygiene, whitening and implants, for every
          age.
        </Text>
        <dl data-animate="fade-up" data-stagger="0.1" class="mt-20 grid gap-12 sm:grid-cols-3 lg:mt-32">
          {
            stats.map((stat) => (
              <div class="border-t border-foreground/15 pt-6">
                <dt>
                  <Text tag="span" variant="displayMD" class="font-display tracking-tight">
                    {stat.value}
                  </Text>
                </dt>
                <dd class="mt-2">
                  <Text tag="span" variant="textSM" class="text-muted-foreground">
                    {stat.label}
                  </Text>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Wrapper>
</section>
