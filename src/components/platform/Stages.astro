---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { stages } from "@/components/platform/journey";
---

{
  stages.map((stage) => (
    <section id={stage.id} class="scroll-mt-24">
      <Wrapper variant="standard" class="py-24">
        <div class="grid gap-16 border-t border-border pt-12 lg:grid-cols-3">
          <div class="flex flex-col items-start gap-6">
            <Text tag="p" variant="textSM" class="flex items-center gap-2 font-medium text-muted-foreground">
              <stage.icon class="size-4 shrink-0" aria-hidden="true" />
              {stage.label}
            </Text>
            <Text tag="h2" variant="displayLG" class="font-display tracking-tight text-balance">
              {stage.heading}
            </Text>
            <Text tag="p" variant="textLG" class="text-pretty text-muted-foreground">
              {stage.summary}
            </Text>
          </div>
          <div class="lg:col-span-2">
            {stage.highlights.length > 0 && (
              <ul data-animate="fade-up" data-stagger="0.08" class="grid gap-2 sm:grid-cols-2">
                {stage.highlights.map((highlight) => (
                  <li class="rounded-3xl bg-muted p-8 lg:rounded-4xl">
                    <Text tag="h3" variant="textXL" class="font-display tracking-tight">
                      {highlight.title}
                    </Text>
                    <Text tag="p" variant="textBase" class="mt-2 text-pretty text-muted-foreground">
                      {highlight.description}
                    </Text>
                  </li>
                ))}
              </ul>
            )}
            <ul
              data-animate="fade-up"
              data-stagger="0.08"
              class:list={["grid gap-x-8 gap-y-10 sm:grid-cols-2", stage.highlights.length > 0 && "mt-12"]}
            >
              {stage.items.map((item) => (
                <li class="border-t border-border pt-5">
                  <Text tag="h3" variant="textLG" class="font-display tracking-tight">
                    {item.title}
                  </Text>
                  <Text tag="p" variant="textBase" class="mt-2 text-pretty text-muted-foreground">
                    {item.description}
                  </Text>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </Wrapper>
    </section>
  ))
}
