---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Check from "@/icons/check.svg";
// Content
import { addOns, formatPrice, included } from "@/components/pricing/plans";
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="grid gap-16 lg:grid-cols-3">
      <div class="flex flex-col gap-6">
        <Text tag="h2" variant="displayXL" class="font-display tracking-tight text-balance">
          Everything you need, included.
        </Text>
        <Text tag="p" variant="textLG" class="text-pretty text-muted-foreground">
          Every plan comes with the same essentials. Usage-based extras are billed only when you use them.
        </Text>
      </div>
      <div class="lg:col-span-2">
        <ul data-animate="fade-up" data-stagger="0.08" class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            included.map((item) => (
              <li class="flex items-center gap-3">
                <Check class="size-6 shrink-0 text-primary" aria-hidden="true" />
                <Text tag="span" variant="textBase" class="font-medium">
                  {item}
                </Text>
              </li>
            ))
          }
        </ul>
        <Text tag="h3" variant="textXL" class="mt-16 font-display tracking-tight">
          Extras
        </Text>
        <ul class="mt-6 divide-y divide-border border-y border-border">
          {
            addOns.map((addOn) => (
              <li class="grid gap-1 py-5 sm:grid-cols-3 sm:gap-4">
                <div class="sm:col-span-2">
                  <Text tag="p" variant="textBase" class="font-medium">
                    {addOn.title}
                  </Text>
                  <Text tag="p" variant="textSM" class="mt-1 text-muted-foreground">
                    {addOn.detail}
                  </Text>
                </div>
                <Text tag="p" variant="textBase" class="font-medium sm:text-right">
                  {formatPrice(addOn.price)}
                  <span class="block text-sm font-normal text-muted-foreground">{addOn.unit}, VAT included</span>
                </Text>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Wrapper>
</section>
