---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
const stats = [
  { value: "4.9", label: "Average rating out of 5" },
  { value: "612", label: "Reviews from real visits" },
  { value: "98%", label: "Would recommend us to a friend" },
];
---

<section>
  <Wrapper variant="standard" class="pt-24">
    <div data-hero class="flex flex-col items-start gap-6">
      <Text tag="h1" variant="display2XL" class="max-w-4xl font-display tracking-tight text-balance">
        In our patients' own words.
      </Text>
      <Text tag="p" variant="textLG" class="max-w-xl text-pretty text-muted-foreground lg:text-balance">
        We read every review, and reply to the ones that tell us how to do better.
      </Text>
    </div>
    <dl class="mt-16 grid gap-8 sm:grid-cols-3">
      {
        stats.map((stat) => (
          <div class="border-t border-border pt-6">
            <dt>
              <Text tag="span" variant="displayMD" class="font-display tracking-tight">
                {stat.value}
              </Text>
            </dt>
            <dd class="mt-2">
              <Text tag="span" variant="textSM" class="text-muted-foreground">
                {stat.label}
              </Text>
            </dd>
          </div>
        ))
      }
    </dl>
  </Wrapper>
</section>
