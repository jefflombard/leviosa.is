---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Arch from "@/icons/arch.svg";
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="relative overflow-hidden rounded-3xl bg-accent px-6 py-24 text-accent-foreground sm:px-10 lg:rounded-4xl lg:px-16">
      <Arch
        aria-hidden="true"
        class="pointer-events-none absolute -right-24 -bottom-24 w-2/3 text-accent-foreground/15 lg:w-1/3"
      />
      <div class="relative grid gap-12 lg:grid-cols-2">
        <Text tag="h2" variant="displayXL" class="max-w-lg font-display tracking-tight text-balance">
          Join the team.
        </Text>
        <div class="flex flex-col items-start">
          <Text tag="p" variant="textLG" class="max-w-md text-accent-foreground/80">
            We are always happy to hear from dentists, hygienists and nurses who care about calm, careful dentistry.
          </Text>
          <Button isLink href="/careers" variant="muted" size="base" class="mt-8">
            See open roles
          </Button>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
