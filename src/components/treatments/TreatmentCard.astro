---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
// Icons
import ArrowRight from "@/icons/arrow-right.svg";
import Corner from "@/icons/corner.svg";
// Content
const { treatment } = Astro.props;
const { title, icon, description, duration, price } = treatment.data;
const icons = import.meta.glob("/src/icons/*.svg", { eager: true, import: "default" });
const Icon = icons[`/src/icons/${icon}.svg`];
---

<article class="group relative flex flex-col justify-between gap-16 rounded-3xl bg-muted p-8 lg:aspect-square lg:rounded-4xl lg:p-12">
  {Icon && <Icon class="size-16 shrink-0 text-primary" aria-hidden="true" />}
  <div>
    <Text tag="h3" variant="displayMD" class="font-display tracking-tight">
      {title}
    </Text>
    <Text tag="p" variant="textBase" class="mt-4 max-w-md text-muted-foreground">
      {description}
    </Text>
    <div class="mt-8 flex items-end justify-between gap-6 border-t border-foreground/10 pt-6">
      <dl class="flex gap-12">
        <div>
          <dt>
            <Text tag="span" variant="textXS" class="text-muted-foreground">
              Duration
            </Text>
          </dt>
          <dd class="mt-1">
            <Text tag="span" variant="textSM">
              {duration}
            </Text>
          </dd>
        </div>
        <div>
          <dt>
            <Text tag="span" variant="textXS" class="text-muted-foreground">
              Price
            </Text>
          </dt>
          <dd class="mt-1">
            <Text tag="span" variant="textSM">
              {price}
            </Text>
          </dd>
        </div>
      </dl>
      <div class="-mr-8 -mb-8 shrink-0 rounded-tl-5xl bg-background pt-3 pl-3 lg:-mr-12 lg:-mb-12">
        <Button
          isLink
          href={`/treatments/${treatment.id}`}
          variant="primary"
          size="2xl"
          iconOnly
          data-notch
          aria-label={`Learn more about ${title}`}
          class="group-hover:bg-primary/90 after:absolute after:inset-0 after:rounded-3xl lg:after:rounded-4xl"
        >
          <ArrowRight slot="icon" class="size-6 transition-transform duration-300 group-hover:-rotate-45" aria-hidden="true" />
        </Button>
      </div>
    </div>
  </div>
  <Corner class="absolute right-0 bottom-19 size-8 text-background" aria-hidden="true" />
  <Corner class="absolute right-19 bottom-0 size-8 text-background" aria-hidden="true" />
</article>
