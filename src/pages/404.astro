---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import Logo from "@/components/assets/Logo.astro";
// Icons
import Smile from "@/icons/smile.svg";
---

<BaseLayout hideNavigation={true} hideFooter={true}>
  <section class="flex h-svh">
    <Wrapper variant="standard" class="flex py-4 lg:py-6">
      <div class="relative flex flex-1 flex-col overflow-hidden rounded-3xl bg-muted p-6 sm:p-10 lg:rounded-4xl lg:p-16">
        <a href="/" class="self-start" aria-label="Scarlet home">
          <Logo />
        </a>
        <Smile
          aria-hidden="true"
          class="pointer-events-none absolute -right-16 -bottom-16 w-2/3 rotate-180 text-secondary lg:w-1/2"
        />
        <div data-hero class="relative my-auto">
          <Text tag="h1" variant="displayLG" class="max-w-xl font-display tracking-tight text-balance">
            This page slipped out, like a baby tooth.
          </Text>
          <Text tag="p" variant="textLG" class="mt-6 max-w-md text-muted-foreground">
            The link may be old or mistyped. Head back home, or book a visit while you're here.
          </Text>
          <div class="mt-10 flex flex-wrap gap-2">
            <Button isLink href="/" variant="primary" size="base">
              Back home
            </Button>
            <Button isLink href="/book" variant="accent" size="base">
              Book a visit
            </Button>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
