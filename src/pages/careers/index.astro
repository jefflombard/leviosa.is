---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import RoleCard from "@/components/careers/RoleCard.astro";
import Perks from "@/components/careers/Perks.astro";
// Content
import { getCollection } from "astro:content";
const roles = (await getCollection("roles")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-24">
      <div data-hero class="flex flex-col items-start gap-6">
        <Text tag="h1" variant="display2XL" class="max-w-4xl font-display tracking-tight text-balance">
          Do your best work, at a kinder pace.
        </Text>
        <Text tag="p" variant="textLG" class="max-w-xl text-pretty text-muted-foreground lg:text-balance">
          We are a small team on one street, and we are hiring.
        </Text>
      </div>
      <div data-animate="fade-up" data-stagger="0.08" class="mt-12 divide-y divide-border border-y border-border">
        {roles.map((role) => <RoleCard role={role} tag="h2" />)}
      </div>
    </Wrapper>
  </section>
  <Perks />
</BaseLayout>
