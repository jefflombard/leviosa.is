---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import TeamCard from "@/components/team/TeamCard.astro";
import Values from "@/components/team/Values.astro";
import Join from "@/components/team/Join.astro";
// Content
import { getCollection } from "astro:content";
const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-24">
      <div data-hero class="flex flex-col items-start gap-6">
        <Text tag="h1" variant="display2XL" class="max-w-4xl font-display tracking-tight text-balance">
          The people behind your smile.
        </Text>
        <Text tag="p" variant="textLG" class="max-w-xl text-pretty text-muted-foreground lg:text-balance">
          A small team, so you see the same faces at every visit.
        </Text>
      </div>
   
      <div class="grid gap-x-2 gap-y-12 sm:grid-cols-2 lg:grid-cols-4 mt-12" data-animate="fade-up" data-stagger="0.08">
        {team.map((member) => <TeamCard member={member} />)}
      </div>
    </Wrapper>
  </section>
  <Values />
  <Join />
</BaseLayout>
